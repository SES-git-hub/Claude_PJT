# 이 파일은 "어떤 환경 변수가 필요한지"를 문서화하는 템플릿입니다.
# 실제 값은 복사본 `.env` 에 채우세요. `.env` 는 .gitignore 로 커밋되지 않습니다.
#
#   cp .env.example .env
#
# 주의: 순수 정적 사이트(GitHub Pages)에서는 빌드 없이 .env 를 읽을 수 없고,
#       브라우저 JS 에 넣은 값은 모두 공개됩니다. 비밀 값은 반드시 서버/서버리스
#       함수 뒤에 두고, 아래는 그런 백엔드를 붙일 때의 예시입니다.

# 외부 API 베이스 URL (공개 가능)
API_BASE_URL=https://api.example.com

# 서버 측에서만 사용하는 비밀 키 (절대 프론트엔드 번들에 포함 금지)
API_SECRET_KEY=
